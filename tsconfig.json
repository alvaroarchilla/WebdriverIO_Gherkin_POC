{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "@wdio/globals/types", "@wdio/cucumber-framework"]
  },

  "include": ["src/**/*.ts", "src/**/*.feature"],
  "exclude": ["node_modules"]
}